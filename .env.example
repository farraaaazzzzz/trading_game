# Copy this file to .env and fill in your real API key. Never commit .env.

# Free API key from https://twelvedata.com/pricing (sign up, no card needed).
# Free tier: 800 requests/day, 8 requests/minute. The app caches quotes for
# 30s and history for 1hr server-side (shared across all players) to stay
# well within that regardless of how many people are playing at once.
TWELVE_DATA_API_KEY=
