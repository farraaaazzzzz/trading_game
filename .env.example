# Copy this file to .env and fill in real values. Never commit .env.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add this exact redirect URI there:
#   http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Used to sign session cookies — must stay stable
# across restarts, otherwise in-progress Google logins can fail.
FLASK_SECRET_KEY=
